{
    "version": 2,
    "buildCommand": "cd frontend && npm run build",
    "outputDirectory": "frontend/dist/expense-tracker/browser",
    "installCommand": "npm install && cd frontend && npm install",
    "routes": [
        {
            "src": "/api/auth/(.*)",
            "dest": "/api/auth.js"
        },
        {
            "src": "/api/expenses/transactions/(.+)",
            "dest": "/api/expenses/transactions.js?id=$1"
        },
        {
            "src": "/api/expenses/subscriptions/(.+)",
            "dest": "/api/expenses/subscriptions.js?id=$1"
        },
        {
            "src": "/api/expenses/investments/(.+)",
            "dest": "/api/expenses/investments.js?id=$1"
        },
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}