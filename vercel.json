{
    "version": 2,
    "buildCommand": "cd frontend && npm run build",
    "outputDirectory": "frontend/dist/expense-tracker/browser",
    "installCommand": "cd frontend && npm install",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "http://localhost:8080/api/$1"
        }
    ],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}